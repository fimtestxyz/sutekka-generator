# Copy to .env.local for local runs. Never commit .env.local, and never
# paste a real value into this file — placeholders only.
# On Vercel, set the same keys in the project settings (Production).

# Neon Postgres (pooled connection for queries; direct for migrations).
# Create the project at https://neon.tech — see PLAN_AUTH_DB.md §17.5.
DATABASE_URL="postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Production domain (e.g. https://sutekka-generator.vercel.app).
# Omit on Vercel previews — Auth.js auto-detects the host.
AUTH_URL="https://<prod-domain>"
# Trust the reverse proxy (Vercel terminates TLS at the edge).
AUTH_TRUST_HOST="true"

# Google OAuth client. Create in Google Cloud Console — see PLAN_AUTH_DB.md §3.
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Reserved — do not set until the Outlook expansion is approved.
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
