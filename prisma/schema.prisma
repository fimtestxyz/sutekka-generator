// Prisma schema for the Sticker Showcase social layer (PLAN_AUTH_DB.md §4.2).
//
// Models in two groups:
//   - Auth.js adapter tables (User, Account, Session, VerificationToken):
//     the exact shape @auth/prisma-adapter expects. Do not rename fields.
//   - Social layer (UserProfile, UserPreference, Sticker, Bookmark, Like,
//     Comment): profiles, keyword preferences, and per-set likes /
//     comments (1-level replies) / bookmarks.
//   - Shop (Order): one row per paid Stripe Checkout Session, created by
//     the Stripe webhook (api/stripe/webhook.js); the download page reads
//     it back by session id. No user account is required to buy.
//
// One Sticker row per sticker SET (slug = set slug, e.g.
// "riemann-rashomon"), not per individual sticker — likes and comments
// on the site are per set, matching the /api/engage behaviour this
// replaces. See prisma/seed.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 removed url/directUrl from the schema (P1012). The
  // migrate-time connection URL lives in prisma.config.ts (DIRECT_URL);
  // the runtime client gets DATABASE_URL via the pg driver adapter
  // in api/_lib/prisma.js. Models below are unchanged from §4.2.
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  profile     UserProfile?
  preferences UserPreference[]
  bookmarks   Bookmark[]
  likes       Like[]
  comments    Comment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  userId       String   @id
  customAvatar String?
  bio          String?  @db.VarChar(280)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id      String @id @default(cuid())
  userId  String
  keyword String
  weight  Float  @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword])
  @@index([userId])
}

model Sticker {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  imageUrl  String
  keywords  String[]
  createdAt DateTime @default(now())

  likes     Like[]
  comments  Comment[]
  bookmarks Bookmark[]

  @@index([createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  stickerId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sticker Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)

  @@unique([userId, stickerId])
  @@index([userId, createdAt])
  @@index([userId, stickerId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  stickerId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sticker Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)

  @@unique([userId, stickerId])
  @@index([stickerId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  stickerId String
  parentId  String?
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sticker Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  parent  Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([stickerId, createdAt])
  @@index([parentId])
  @@index([userId])
}

model Order {
  id                    String   @id @default(cuid())
  stripeSessionId       String   @unique
  stripePaymentLinkId   String?
  stripePaymentIntentId String?
  buyerEmail            String?
  itemId                String
  itemType              String
  amountTotal           Int
  currency              String   @default("sgd")
  status                String   @default("paid")
  // Admin / print / invoice fields (ADMIN.md §5). Stripe-owned facts
  // (ids, email, item, amount) are set by the webhook; admin-managed
  // fields (printStatus, shipping, tracking, notes, refund) are never
  // overwritten by a webhook redelivery — see api/stripe/webhook.js.
  payMethodType         String?
  filesJson             Json?
  printStatus           String   @default("none")
  shippingName          String?
  shippingAddress       Json?
  trackingCourier       String?
  trackingNumber        String?
  invoiceId             String?
  invoiceNumber         String?
  adminNotes            String?  @db.Text
  refundedAt            DateTime?
  cancelReason          String?
  invoiceRequestedAt    DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  invoiceRequest InvoiceRequest?

  @@index([buyerEmail])
  @@index([createdAt])
  @@index([printStatus])
  @@index([status])
}

// Admin account (ADMIN.md §2). Created once by the first-run setup
// form at #/kangle; the password hash is scrypt (node:crypto), never
// an env var. A second row is how a helper admin is added (v2).
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AdminSession[]
}

// Admin session (ADMIN.md §2). The cookie carries a random token; only
// its SHA-256 hash is stored. Logout / revoke-all delete rows; no JWT,
// no session secret.
model AdminSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

// Audit log (ADMIN.md §4.9). Append-only: every admin action that
// touches money, fulfilment or settings writes one row. No updates,
// no deletes.
model AuditLog {
  id        String   @id @default(cuid())
  adminUser String
  action    String
  orderId   String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([createdAt])
}

// Buyer's formal-invoice request queue (ADMIN.md §4.2).
model InvoiceRequest {
  id         String   @id @default(cuid())
  orderId    String   @unique
  buyerEmail String?
  status     String   @default("open")
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// Webhook health (ADMIN.md §4.9). One row per Stripe event the webhook
// handler processes, ok or error — the admin health view reads this.
model WebhookEvent {
  id              String   @id @default(cuid())
  type            String
  stripeSessionId String?
  status          String
  error           String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// Site settings the admin can change (ADMIN.md §4.7): shop_closed,
// announcement, hidden_items (JSON array of item ids). Read by the
// public GET /api/settings; written only by the admin.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
